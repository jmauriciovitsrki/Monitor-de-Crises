rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation helper for a daily log entity
    function isValidDailyLog(data) {
      return data.keys().hasAll(['userId', 'date', 'sleep', 'seizures', 'medication', 'createdAt', 'updatedAt'])
        && data.keys().size() == 7
        && data.userId == request.auth.uid
        && data.date is string
        && data.date.size() == 10
        && data.sleep is map
        && data.sleep.status is string
        && (data.sleep.status == 'dormiu' || data.sleep.status == 'não dormiu' || data.sleep.status == 'dormiu tarde')
        && data.sleep.quality is int
        && data.sleep.quality >= 1
        && data.sleep.quality <= 5
        && data.sleep.wakeUpCount is int
        && data.sleep.wakeUpCount >= 0
        && data.sleep.observations is string
        && data.sleep.observations.size() <= 4096
        && data.seizures is map
        && data.seizures.occurred is bool
        && data.seizures.totalCount is int
        && data.seizures.totalCount >= 0
        && data.seizures.triggers is string
        && data.seizures.triggers.size() <= 4096
        && data.seizures.observations is string
        && data.seizures.observations.size() <= 4096
        && data.medication is map
        && data.medication.taken is bool
        && data.medication.observations is string
        && data.medication.observations.size() <= 4096;
    }

    // User tracking collection rules
    match /users/{userId}/logs/{logId} {
      // Secure List / Detail query evaluations
      allow read: if isOwner(userId);

      // Create rule enforcing absolute validation rules on data entry
      allow create: if isOwner(userId)
        && isValidId(logId)
        && isValidDailyLog(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Update rules restricting key violations and temporal values
      allow update: if isOwner(userId)
        && isValidId(logId)
        && isValidDailyLog(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Delete rule allowing users to curate their historical data partitions
      allow delete: if isOwner(userId);
    }
  }
}
