rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check route permitted for status health verify
    match /test/connection {
      allow read: if true;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Validation helper for a daily log entity (relaxed to avoid batch transaction rollbacks on slight format differences)
    function isValidDailyLog(data, userId) {
      return data != null && data.userId == userId;
    }

    // User tracking collection rules
    match /users/{userId}/logs/{logId} {
      // Secure List / Detail query evaluations
      allow read: if isOwner(userId);

      // Create rule enforcing absolute validation rules on data entry
      allow create: if isOwner(userId)
        && isValidId(logId)
        && isValidDailyLog(request.resource.data, userId);

      // Update rules restricting key violations and temporal values
      allow update: if isOwner(userId)
        && isValidId(logId)
        && isValidDailyLog(request.resource.data, userId);

      // Delete rule allowing users to curate their historical data partitions
      allow delete: if isOwner(userId);
    }

    // Medication collection rules
    match /users/{userId}/medications/{medicationId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(medicationId)
        && request.resource.data != null && request.resource.data.userId == userId;
      allow update: if isOwner(userId)
        && isValidId(medicationId)
        && request.resource.data != null && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
  }
}
